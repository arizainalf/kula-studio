{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trainlog-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "vars": {
    "ENV": "dev"
  },
  "d1_databases": [],
  "r2_buckets": [
    {
      "binding": "PHOTOS_BUCKET",
      "bucket_name": "trainlog-photos"
    }
  ],
  "observability": { "enabled": true }
}
